<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Local-first: the data stays on the phone and leaves it only through the backup file the
         user chooses. allowBackup is off, so there is nothing for data extraction rules to
         govern. No permissions are needed yet. -->
    <application
        android:allowBackup="false"
        tools:ignore="DataExtractionRules"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Urlaubsplaner">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
