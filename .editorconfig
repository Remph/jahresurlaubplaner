root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_size = 4
max_line_length = 100
ktlint_code_style = ktlint_official
# Composable functions are named like types.
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{xml,toml,json,yml,yaml,md}]
indent_size = 2
