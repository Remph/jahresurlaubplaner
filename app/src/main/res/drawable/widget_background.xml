<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 only: Glance cannot round a view there, so this shape is stretched behind the
     widget and tinted with its colour. From Android 12 the launcher rounds the view. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFFFFFFF" />
    <corners android:radius="24dp" />
</shape>
